modules = ["python-3.12", "web", "nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/hocvu: web"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hocvu-admin-frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hocvu-admin-browser"

[[workflows.workflow]]
name = "hocvu-admin-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/hocvu test && pnpm --filter @workspace/hocvu typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "hocvu-admin-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/hocvu test:browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cacert", "freetype", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "postgresql", "swig", "tcl", "tesseract", "tk", "xcbuild", "zlib"]

[userenv]

[userenv.development]
HV_BROWSER_AUTH = "1"
HV_SEMANTIC = "0"
HV_STORAGE_BACKEND = "replit"
HV_STORAGE_BUCKET_ID = "replit-objstore-45d95f2e-5cd1-4fa9-b219-db2535ac1bd4"

[userenv.shared]
HV_STORAGE_PREFIX = "hocvu/v1"

[userenv.production]
HV_STORAGE_BACKEND = "replit"

[objectStorage]
defaultBucketID = "replit-objstore-45d95f2e-5cd1-4fa9-b219-db2535ac1bd4"
