modules = ["python-3.12", "nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hocvu-admin-frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hocvu-admin-browser"

[[workflows.workflow]]
name = "hocvu-admin-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/hocvu test && pnpm --filter @workspace/hocvu typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "hocvu-admin-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/hocvu test:browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "postgresql", "swig", "tcl", "tesseract", "tk", "xcbuild", "zlib"]

[userenv]

[userenv.development]
HV_BROWSER_AUTH = "1"
HV_SEMANTIC = "0"
HV_STORAGE_BACKEND = "replit"

[userenv.shared]
HV_STORAGE_PREFIX = "hocvu/v1"

[userenv.production]
HV_STORAGE_BACKEND = "replit"

[objectStorage]
defaultBucketID = "replit-objstore-5ab5d012-9124-4510-824f-72d165a9d80c"
