# HocVu AI Environment Configuration Example
# Copy this file to .env and configure as needed.

HV_TOP_K=3
HV_BM25_POOL=20
HV_VEC_POOL=20
HV_BM25_WEIGHT=0.5
HV_EMBED_DIM=384
HV_MAX_CHUNK_CHARS=1000
HV_OVERLAP_SENTS=1
HV_CONFIDENCE_FLOOR=0.4
HV_SEMANTIC_FLOOR=0.7
HV_MAX_UNITS=2
HV_MAX_HISTORY=5

HV_LLM=local
HV_STT=browser
HV_TTS=browser

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

WHISPER_MODEL=base
TTS_VOICE=vi-VN-HoaiMyNeural
HV_SEED=42
