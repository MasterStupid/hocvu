# HocVu AI Environment Configuration Example
# Copy this file to .env and configure as needed.

HV_TOP_K=5
HV_BM25_POOL=15
HV_VEC_POOL=15
HV_BM25_WEIGHT=0.10
HV_EMBED_DIM=1024
HV_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HV_SEMANTIC=true
HV_MAX_CHUNK_CHARS=800
HV_OVERLAP_SENTS=1
HV_CONFIDENCE_FLOOR=0.28
HV_SEMANTIC_FLOOR=0.20
HV_LEXICAL_COVERAGE_FLOOR=0.50
HV_MAX_UNITS=2
HV_MAX_HISTORY=8

HV_LLM=local
HV_STT=local
HV_TTS=local

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini (use HV_LLM=gemini and put the real key only in your untracked .env)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

WHISPER_MODEL=small
TTS_VOICE=vi-VN-HoaiMyNeural
HV_API_TOKEN=
HV_RATE_LIMIT_PER_MINUTE=120
HV_SEED=20262027

# Optional hosted-data location. Leave empty for local development.
# Example on Render with a persistent disk: /var/data
# HV_DATA_DIR=/var/data
